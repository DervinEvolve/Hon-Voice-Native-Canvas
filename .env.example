# Hon configuration template. Copy to .env.local (never commit it) and fill in
# only what you use. Every variable the code reads is listed here, grouped by
# feature, with no values. Missing configuration denies access or disables
# that feature; nothing falls back to a shared key.
#
# Rules:
# - VITE_* values are compiled into the browser bundle. Put only public
#   configuration there, never a provider secret.
# - Everything else is server-only: Vercel project settings for deployments,
#   .env.local for `npm run dev`.
# - Where the code accepts several names for one key (aliases), set one.

# ---------------------------------------------------------------------------
# Browser (public, compiled into the bundle)
# ---------------------------------------------------------------------------
# Supabase project URL and its public anon/publishable key, for sign-in and canvas history.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Cloudinary cloud name and unsigned upload preset for browser uploads.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Cloudinary API key (an identifier, not the secret), read by src/utils/mediaService.ts.
VITE_CLOUDINARY_API_KEY=
# 'true' to show Privy sign-in; the Privy app ID (public).
VITE_PRIVY_ENABLED=
VITE_PRIVY_APP_ID=
# hCaptcha site key (public) for the login form.
VITE_HCAPTCHA_SITE_KEY=
# Google Maps browser key (restrict it by HTTP referrer) and map ID for the 3D world view.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
# Solana network name and RPC URL for the old wallet features.
VITE_SOLANA_NETWORK=
VITE_SOLANA_RPC_URL=
# Public base URL of the app; defaults to http://localhost:5173.
VITE_APP_URL=
# 'true' to show the waitlist screen instead of the app.
VITE_WAITLIST_MODE=
# Optional storage you own for the 44 credited GLB models; defaults to /assets/3d.
VITE_3D_ASSET_BASE_URL=
# Optional external animation library with a verified source and redistribution terms.
VITE_ANIMATION_LIBRARY_URL=
# 'true' builds the voice scene builder (pc_execute, pc_* script tools) into the page. It runs model-written code
# in the signed-in page without a sandbox. Off by default; the server also needs HON_ENABLE_SCENE_CODE_EXECUTION.
VITE_ENABLE_SCENE_CODE_EXECUTION=
# Build-time only: space-separated hosts that replace `https:` in the page's CSP connect-src (see csp.config.js).
VITE_CSP_CONNECT_SRC=

# ---------------------------------------------------------------------------
# API access gate (every /api route). See docs/API_ACCESS_SETUP.md.
# ---------------------------------------------------------------------------
# Comma-separated verified Supabase user IDs and/or Privy DIDs allowed to call /api. Empty denies everyone.
HON_API_ALLOWED_USER_IDS=
# The app's own origin (for example https://canvas.example); other origins are refused.
HON_APP_ORIGIN=
# Supabase project URL used to verify access tokens (falls back to VITE_SUPABASE_URL).
SUPABASE_URL=
# Public Supabase key used only to verify tokens. SUPABASE_ANON_KEY is accepted as an alias.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# Privy app ID (falls back to VITE_PRIVY_APP_ID) and the app's public SPKI verification key.
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=
# Optional canonical origin for authenticated server-to-server tool calls.
HON_INTERNAL_API_ORIGIN=

# ---------------------------------------------------------------------------
# Request budget (apply migrations/api_request_budget.sql first)
# ---------------------------------------------------------------------------
# Server-only Supabase secret key for the budget ledger, SHARP jobs and memory.
# SUPABASE_SECRET_KEY is read first; SUPABASE_SERVICE_ROLE_KEY and
# SUPABASE_SERVICE_KEY are older names kept as fallbacks. Never expose any of them to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=
# Per verified user per hour; defaults 60 and 600. Ledger failure denies work.
HON_API_MUTATIONS_PER_HOUR=60
HON_API_READS_PER_HOUR=600
# Paid image, video, audio, 3D and splat jobs per verified user per hour (routes in api/_lib/paid-routes.js). Default 20.
HON_API_PAID_JOBS_PER_HOUR=20

# ---------------------------------------------------------------------------
# Speech-to-speech (Hume EVI)
# ---------------------------------------------------------------------------
# Hume API key and secret, used to mint short-lived EVI access tokens.
HUME_API_KEY=
HUME_SECRET_KEY=
# EVI configuration with Hon's tools and prompt (set up in the Hume dashboard).
HUME_CONFIG_ID=
# EVI configuration for the landing-page voice demo.
HUME_LANDING_CONFIG_ID=

# ---------------------------------------------------------------------------
# Language models
# ---------------------------------------------------------------------------
# 'true' lets /api/playcanvas/execute, execute-subtask and parallel-execute generate scene code. Off by default.
HON_ENABLE_SCENE_CODE_EXECUTION=
# Anthropic key for pc_execute, scene tools, game generation and Notion actions. CLAUDE_API_KEY is an alias.
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
# Older form of the same key split in three parts, read only by game generation. Prefer
# ANTHROPIC_API_KEY; if you need the old form, uncomment and set all three:
# CLAUDE_API_KEY_PART1=
# CLAUDE_API_KEY_PART2=
# CLAUDE_API_KEY_PART3=
# Optional model override for game generation.
CLAUDE_MODEL=
# Google Gemini key for game generation and editing. GOOGLE_AI_API_KEY is an alias.
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
# xAI key for game generation. XAI_KEY and GROK_API_KEY are aliases.
XAI_API_KEY=
XAI_KEY=
GROK_API_KEY=
# OpenAI key for image edits, Whisper transcription and Sora video.
OPENAI_API_KEY=
# '1' to send Sora requests to OpenAI directly instead of through fal.ai.
SORA_USE_OPENAI=

# ---------------------------------------------------------------------------
# Image, video, audio and 3D generation providers
# ---------------------------------------------------------------------------
# fal.ai key. Different routes read different names: FAL_API_KEY (most), FAL_AI_API_KEY (Seedream, Meshy, GPT image), FAL_KEY (Veo 3.1). Set all three to the same key.
FAL_API_KEY=
FAL_AI_API_KEY=
FAL_KEY=
# Shared secret the Veo 3.1 webhook expects in its URL; leave empty and the webhook accepts any caller.
FAL_WEBHOOK_SECRET=
# Luma AI key. LUMA_API_KEY is an alias.
LUMAAI_API_KEY=
LUMA_API_KEY=
# Runway key for image and video generation.
RUNWAY_API_KEY=
# Higgsfield key and secret for image, video, motion and speech routes.
HIGGSFIELD_API_KEY=
HIGGSFIELD_SECRET=
# Replicate token for Hunyuan3D and some game assets. REPLICATE_API_KEY and REPLICATE_KEY are aliases.
REPLICATE_API_TOKEN=
REPLICATE_API_KEY=
REPLICATE_KEY=
# ElevenLabs key for text to speech and sound effects.
ELEVENLABS_API_KEY=
# Roboflow key for SAM 3 object detection.
ROBOFLOW_API_KEY=
# Anything World key for rigging and animating 3D models.
ANYTHING_WORLD_API_KEY=
# Google Maps server key (restrict it by API and IP) for geocoding in the world view.
GOOGLE_MAPS_SERVER_KEY=

# ---------------------------------------------------------------------------
# Media storage and downloads
# ---------------------------------------------------------------------------
# Cloudinary credentials for server-side uploads. The cloud name falls back to VITE_CLOUDINARY_CLOUD_NAME.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# Media download proxy: allowed users and exact CDN hostnames (no wildcards).
HON_MEDIA_ALLOWED_USER_IDS=
HON_MEDIA_DOWNLOAD_HOSTS=

# ---------------------------------------------------------------------------
# Image to splat (SHARP on Modal). See docs/SPLAT_SECURITY_SETUP.md and modal/README.md.
# ---------------------------------------------------------------------------
# Users allowed to start SHARP jobs and LOD processing.
HON_SPLAT_ALLOWED_USER_IDS=
# Exact image source hostnames; also set in the Modal secret hon-sharp-config.
HON_SPLAT_IMAGE_HOSTS=
# Deployed worker URL (*.modal.run) and a dedicated Modal proxy token, never a workspace token.
MODAL_SHARP_ENDPOINT=
MODAL_SHARP_PROXY_KEY=
MODAL_SHARP_PROXY_SECRET=
# 'true' to allow multi-file LOD output in the public hon-assets bucket. Keep unset for private scenes.
HON_ALLOW_PUBLIC_LOD_OUTPUT=

# ---------------------------------------------------------------------------
# Google and Notion connections
# ---------------------------------------------------------------------------
# At least 32 random bytes; signs OAuth state and provider cookies. Rotating it disconnects integrations.
HON_OAUTH_STATE_SECRET=
# At least 32 random bytes; binds provider job IDs to the user who started them (falls back to HON_OAUTH_STATE_SECRET).
HON_JOB_ID_SECRET=
# Google OAuth client and its exact redirect URL (…/api/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Notion OAuth client and its exact redirect URL (…/api/notion/mcp-callback).
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_MCP_REDIRECT_URI=
# Optional Notion API version header; defaults to 2022-06-28.
NOTION_API_VERSION=

# ---------------------------------------------------------------------------
# Hume memory handlers
# ---------------------------------------------------------------------------
# api/hume/memoryHandlers.js reads the project URL from SUPABASE_URL, VITE_SUPABASE_URL or this name, with the server key above.
NEXT_PUBLIC_SUPABASE_URL=

# ---------------------------------------------------------------------------
# Local development servers (npm run dev)
# ---------------------------------------------------------------------------
# Port of the local API server (default 3000) and of the media proxy.
PORT=
PROXY_PORT=
# Comma-separated origins the local media proxy accepts; defaults to the Vite dev origins.
LOCAL_APP_ORIGINS=

# ---------------------------------------------------------------------------
# Manual smoke scripts (scripts/verify-production.ts, scripts/test-game-types.ts)
# ---------------------------------------------------------------------------
# Deployment you own to check, and an access token for an allowlisted user there.
HON_TEST_BASE_URL=
HON_TEST_ACCESS_TOKEN=

# Set by the platform; do not set them yourself: NODE_ENV, VERCEL_ENV, VERCEL_URL.
