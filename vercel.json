    },
    "api/higgsfield/motions.js": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/higgsfield/speak.js": {
      "memory": 1024,
      "maxDuration": 300
    },
    "api/flux/edit.js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/flux/krea.js": {
      "memory": 1024,
      "maxDuration": 120
    },
    "api/ideogram/generate.js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/imagen4/generate.js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/hunyuan3d/generate.js": {
      "memory": 1024,
      "maxDuration": 240
    },
    "api/runway/image-to-video.js": {
      "memory": 1024,
      "maxDuration": 300
    },
    "api/veo3/image-to-video.js": {
      "memory": 1024,
      "maxDuration": 120
    },
    "api/fal/video-understanding.js": {
      "memory": 1024,
      "maxDuration": 300
    },
    "api/luma/video-generation.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/luma/text-to-video.js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/pika/text-to-video.js": {
