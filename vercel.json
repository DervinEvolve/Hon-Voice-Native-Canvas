    },
    "api/cloudinary-upload.js": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/download-image.js": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/gpt/text-to-image.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/gpt/edit-image.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/gemini/flash-edit.js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/flux/generate.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/flux/lora.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/luma/generate.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/luma/photon.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/recraft/generate.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/easel/generate.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/bria/generate.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/kling/text-to-video.js": {
      "memory": 1024,
      "maxDuration": 90
    },
    "api/luma/photon-flash.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/recraft/upscale.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/video/prompt-optimizer.js": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/fal/moondream.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/fal/seedream-generate.js": {
      "memory": 1024,
      "maxDuration": 120
    },
    "api/fal/seedream-edit.js": {
      "memory": 1024,
      "maxDuration": 120
    },
    "api/fal/seedream-status.js": {
      "memory": 512,
